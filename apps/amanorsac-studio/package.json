{
  "name": "amanorsac-studio",
  "productName": "Amanorsac Studio",
  "version": "1.0.0",
  "description": "Amanorsac Studio — sampling application for the Amanorsac sound library (.aofas)",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@amanorsac/aofas-format": "1.0.0",
    "@jm/jmi-format": "1.0.0",
    "@wasm-audio-decoders/flac": "^0.2.11",
    "adm-zip": "^0.5.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "node-web-audio-api": "^2.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "author": "Amanorsac Studio"
}
