{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jmstudios.example/schema/preset.schema.json",
  "title": "JM .jmi preset (presets/*.json)",
  "type": "object",
  "required": ["formatVersion", "name", "engine", "fxRack", "ampEnvelope"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "engine": {
      "description": "Per-world engine params, keyed by the world's canonical control ids (see fx-params docs). Values are normalized 0..1 unless the control is an enum/int.",
      "type": "object",
      "additionalProperties": { "type": ["number", "string", "boolean", "integer"] }
    },
    "fxRack": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["type", "bypassed", "params"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "jmChorus", "tremoloAutoPan", "phaser", "flanger", "epPreamp",
              "vintageEq", "compressor", "tapeDelay", "digitalDelay",
              "plateReverb", "hallShimmer", "widener"
            ]
          },
          "bypassed": { "type": "boolean" },
          "params": {
            "type": "object",
            "additionalProperties": { "type": ["number", "string", "boolean", "integer"] }
          }
        }
      }
    },
    "ampEnvelope": {
      "type": "object",
      "required": ["attackMs", "decayMs", "sustain", "releaseMs"],
      "additionalProperties": false,
      "properties": {
        "attackMs": { "type": "number", "minimum": 0, "maximum": 5000 },
        "decayMs": { "type": "number", "minimum": 0, "maximum": 10000 },
        "sustain": { "type": "number", "minimum": 0, "maximum": 100 },
        "releaseMs": { "type": "number", "minimum": 1, "maximum": 10000 }
      }
    }
  }
}
