/* The MIREKU site on Cloudflare Workers.

   Workers Builds is connected to this repository's main branch with the
   root directory "site", so this file is read from here.

   "name" MUST match the Worker's name in the Cloudflare dashboard, or the
   build stops. It is set to "mireku"; change it if your Worker is called
   something else.

   Files first: a request for /account is answered with
   public/account.html without running any code. Only a request that no
   file matches reaches worker.js, which answers /api/auth-email (MIREKU's
   own account emails) and hands everything else back to the files, so
   an unknown address still gets public/404.html with a 404 status.

   Secrets, set in Cloudflare and never written here: RESEND_API_KEY and
   AUTH_HOOK_SECRET and DOWNLOAD_SECRET (see worker.js). */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mireku",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  /* The studio's download bucket, read for MIREKU's files (MIREKU/...). */
  "r2_buckets": [
    { "binding": "DOWNLOADS", "bucket_name": "amanorsac-downloads" }
  ],
  "preview_urls": true,
  "observability": { "enabled": true }
}
